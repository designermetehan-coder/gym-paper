// Copy to Secrets.xcconfig (git-ignored) and fill in. Never commit real values.
// Note: xcconfig treats // as a comment, so the Supabase host is written without https://

GP_BUNDLE_ID = com.yourname.gympaper
GP_TEAM_ID = ABCDE12345
GP_SUPABASE_HOST = your-project-ref.supabase.co
GP_SUPABASE_ANON_KEY = your-publishable-anon-key
